---
import { siteConfig, navLinks } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-brand">{siteConfig.brand}</div>
      <p class="footer-copy">
        Answer Engine Optimization for brands that need to be found—and correctly
        cited—inside AI answers. Hong Kong experiment.
      </p>
    </div>
    <div class="footer-col">
      <h4>Explore</h4>
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="footer-col">
      <h4>Contact</h4>
      <ul>
        <li>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </li>
        <li>
          <span style="color: var(--text-muted); font-size: 0.92rem;"
            >{siteConfig.region}</span
          >
        </li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {siteConfig.brand}. All rights reserved.</span>
    <span>Built for answer engines · Static HTML first</span>
  </div>
</footer>
